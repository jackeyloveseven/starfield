<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (Android 8+). The foreground carries the ring and
     the shadow; the background is the ink paper gradient. Without this file the
     launcher shrinks the legacy PNG into a white circle. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_mono" />
</adaptive-icon>
