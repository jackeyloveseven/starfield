<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StarfieldFocus" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>

    <style name="Theme.StarfieldFocus.Fullscreen" parent="Theme.StarfieldFocus">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <!-- Draw into the punch-hole area: without shortEdges a 1280x2772 phone
             letterboxes the app below the status bar, which reads as "the top
             is not filled". -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
