; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but since it is all text-based, you can also edit it.

config_version=5

[application]

config/name="星空 · STARFIELD"
config/description="A Mathematical Universe Folded on Paper - Native Godot 4.3 Engine Port"
config/version="1.15.1"
config/use_custom_user_dir=true
config/custom_user_dir_name="starfield_godot"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus", "Mobile")
boot_splash/bg_color=Color(0.055, 0.067, 0.09, 1.0)
boot_splash/show_image=false
config/icon="res://icon.svg"

[debug]

file_logging/enable_file_logging=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0
window/handheld/orientation=6

[gui]

theme/custom_font="res://fonts/simhei.ttf"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.055, 0.067, 0.09, 1.0)
